# Optional: override the character path (default /models/beaver.glb).
# If the file is missing, the built-in procedural beaver is used.
# Recognised clips: "Idle", "Typing", "Blink" (any subset). See utils/beaverConfig.ts.
NEXT_PUBLIC_BEAVER_MODEL=

# Optional: path to an .hdr environment map, e.g. /hdr/studio_small_08_1k.hdr
# When unset, a light-weight procedural studio environment is generated.
NEXT_PUBLIC_HDR_URL=

# Optional: Resend (or similar) key for the contact form route.
CONTACT_WEBHOOK_URL=
