# Optional: override the character path (default /models/beaver.glb).
# If the file is missing, the built-in procedural beaver is used.
# Recognised clips: "Idle", "Typing", "Blink" (any subset). See utils/beaverConfig.ts.
NEXT_PUBLIC_BEAVER_MODEL=

# Optional: path to an .hdr environment map, e.g. /hdr/studio_small_08_1k.hdr
# When unset, a light-weight procedural studio environment is generated.
NEXT_PUBLIC_HDR_URL=

# Live site address (no trailing slash) — used for SEO, sitemap and links.
NEXT_PUBLIC_SITE_URL=https://beavercodes.com

# ---- Contact form delivery (app/api/contact/route.ts) ----
# Email through your Hostinger mailbox (SMTP). Set these in Vercel:
# Project → Settings → Environment Variables. Never commit the password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@beavercodes.com
SMTP_PASS=
# Where enquiries are delivered (defaults to SMTP_USER).
CONTACT_TO=hello@beavercodes.com
# "true" = also send the customer an automatic "we got your message" email.
CONTACT_AUTOREPLY=true

# Optional extra channel: Slack / Discord / Zapier / Make webhook URL.
CONTACT_WEBHOOK_URL=
